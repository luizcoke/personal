.venv/
__pycache__/
*.py[cod]

# Credenciais e configuração exclusiva desta máquina.
despesas-pessoais/config.local.json

# Planilhas pessoais mantidas apenas nesta máquina.
despesas-pessoais/planilhas/

# Documentos originais, imagens e arquivos derivados volumosos ficam locais.
despesas-pessoais/periodos/*/entradas/
despesas-pessoais/periodos/*/auditoria/extracao/
despesas-pessoais/periodos/*/auditoria/referencias/
despesas-pessoais/modelos/referencias/
despesas-pessoais/**/*.pdf
despesas-pessoais/**/*.png
despesas-pessoais/**/*.jpg
despesas-pessoais/**/*.jpeg

# Cópias antigas e arquivos temporários, sem apagar os originais locais.
despesas-pessoais/historico/
despesas-pessoais/periodos/*/auditoria/historico/
despesas-pessoais/.verificacao-*/
despesas-pessoais/**/*.tmp

# Versionar conhecimento, modelos, código, periodo.json,
# resultados mensais e auditoria/dados (incluindo fechamento_manual.json).
